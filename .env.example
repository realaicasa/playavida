# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Teable Backend Configuration (Server-Side Only)
# Never expose TEABLE_API_KEY or Table IDs directly to the client browser
TEABLE_API_BASE="https://app.teable.ai/api"
TEABLE_API_KEY="teable_sec_token_here"
TEABLE_OTP_TABLE_ID="tbl_otp_codes"
TEABLE_SESSIONS_TABLE_ID="tbl_sessions"
TEABLE_TABLE_BUSINESSES="tbl_businesses"
TEABLE_TABLE_CONTACTS="tbl_business_private_contacts"
TEABLE_TABLE_SUBSCRIPTIONS="tbl_business_subscriptions"
TEABLE_TABLE_USERS="tbl_users"
TEABLE_TABLE_REPORTS="tbl_reports"
TEABLE_TABLE_LOYALTY_PROGRAMS="tbl_loyalty_programs"
TEABLE_TABLE_LOYALTY_CARDS="tbl_loyalty_cards"
TEABLE_TABLE_LOYALTY_LEDGER="tbl_loyalty_ledger"

